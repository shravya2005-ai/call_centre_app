# Exotel API Credentials
# Get these from: https://my.exotel.com/exoml/dashboard (Settings > API)
EXOTEL_API_KEY=your_api_key_here
EXOTEL_API_TOKEN=your_api_token_here
EXOTEL_ACCOUNT_SID=your_account_sid_here
EXOTEL_EXOPHONE=your_exophone_number_here

# Server Configuration
PORT=3001

# Frontend URL (for CORS - update in production)
FRONTEND_URL=http://localhost:5173

# Webhook Base URL (must be publicly accessible HTTPS in production)
# For local dev, use ngrok: https://your-ngrok-subdomain.ngrok.io
# For production: https://your-domain.com
WEBHOOK_BASE_URL=https://your-webhook-url.com
